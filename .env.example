APP_NAME="MS-03 Comercial y Financiero"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5433
DB_DATABASE=ms03_comercial
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_SEARCH_PATH=comercial,public

SESSION_DRIVER=array
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=






KEYCLOAK_ISSUER=http://localhost:8080/realms/alojate
KEYCLOAK_AUDIENCE=ms03-comercial-financiero
KEYCLOAK_JWKS_URL=http://localhost:8080/realms/alojate/protocol/openid-connect/certs
KEYCLOAK_JWKS_TTL=3600

COMERCIAL_BROKER_DRIVER=log
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_EXCHANGE=comercial.events

COMERCIAL_CORS_ORIGINS=http://localhost:5173,http://localhost:4200,http://localhost:9000,http://localhost:3000
